{
  "name": "asl-university",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": [
      "/", "/api/*",
      "/member", "/member.html",
      "/growth-program", "/growth-program.html",
      "/asl-xauusd-analysis", "/asl-xauusd-analysis.html",
      "/asl-account-journal", "/asl-account-journal.html",
      "/asl-markets-pro", "/asl-markets-pro.html"
    ]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "asl-db", "database_id": "b0ace84e-29e9-4cce-84ef-7b825850047b" }
  ],
  "observability": { "enabled": true }
}
